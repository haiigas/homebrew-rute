#!/usr/bin/env bash
# rute — map local domains to ports over HTTPS.
# Thin orchestrator over nginx + mkcert + /etc/hosts. No proxy of its own.
set -uo pipefail

VERSION="0.1.1"
PROG="rute"

BREW="${RUTE_PREFIX:-$(brew --prefix 2>/dev/null || echo /opt/homebrew)}"
NGINX_DIR="$BREW/etc/nginx"
NGINX_SERVERS="$NGINX_DIR/servers"
NGINX_CERTS="$NGINX_DIR/certs"
HOSTS="${RUTE_HOSTS:-/etc/hosts}"

RUTE_HOME="${RUTE_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/rute}"
ROUTES="$RUTE_HOME/routes"
CERT_SIG="$RUTE_HOME/certsig"
CONF="$NGINX_SERVERS/rute.conf"
CERT="$NGINX_CERTS/rute.pem"
KEY="$NGINX_CERTS/rute-key.pem"

# ---- helpers ---------------------------------------------------------------

have()  { command -v "$1" >/dev/null 2>&1; }
die()   { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
info()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
sum()   { shasum "$1" 2>/dev/null | awk '{print $1}'; }

usage() {
  cat <<EOF
$PROG $VERSION — map local domains to ports over HTTPS

usage:
  $PROG add <domain> <port>     map domain -> 127.0.0.1:port
  $PROG rm  <domain>            remove a mapping
  $PROG ls                      list mappings
  $PROG sync                    regenerate nginx/hosts/cert and reload
  $PROG doctor                  check dependencies and services
  $PROG -h | --help
  $PROG --version

examples:
  $PROG add example.local        4002
  $PROG add api.example.local    8080
  $PROG add pay.example.local    4003
  $PROG add example.test         4006
  $PROG add studio.example.test  8001

every domain is added one by one. requires nginx + mkcert (brew). first run
asks sudo to edit /etc/hosts and to start nginx.
EOF
}

valid_domain() {
  printf '%s' "$1" | grep -Eq '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]([a-z0-9-]*[a-z0-9])?$'
}

valid_port() { printf '%s' "$1" | grep -Eq '^[0-9]{1,5}$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

# ---- state -----------------------------------------------------------------

state_init() { mkdir -p "$RUTE_HOME"; [ -f "$ROUTES" ] || : > "$ROUTES"; }

state_add() {
  local d="$1" p="$2" tmp; state_init; tmp="$(mktemp)"
  awk -v d="$d" '!($1==d && $1 !~ /^#/) { print }' "$ROUTES" > "$tmp"
  printf '%s %s\n' "$d" "$p" >> "$tmp"
  mv "$tmp" "$ROUTES"
}

state_del() {
  local d="$1" tmp; state_init; tmp="$(mktemp)"
  awk -v d="$d" '!($1==d && $1 !~ /^#/) { print }' "$ROUTES" > "$tmp"
  mv "$tmp" "$ROUTES"
}

domains()   { awk 'NF && $1 !~ /^#/ { print $1 }' "$ROUTES"; }

# ---- generation ------------------------------------------------------------

gen_nginx() {
  local tmp; tmp="$(mktemp)"
  {
    printf '# generated by %s %s — do not edit\n' "$PROG" "$VERSION"
    local names def
    names="$(domains | paste -sd' ' -)"
    def="$(awk 'NF && $1 !~ /^#/ { print $2; exit }' "$ROUTES")"
    [ -n "$def" ] || def=502

    printf 'map $host $rute_up {\n'
    printf '    default 127.0.0.1:%s;\n' "$def"
    awk 'NF && $1 !~ /^#/ { printf "    %s 127.0.0.1:%s;\n", $1, $2 }' "$ROUTES"
    printf '}\n\n'

    if [ -n "$names" ]; then
      printf 'server {\n    listen 443 ssl;\n    http2 on;\n'
      printf '    server_name %s;\n' "$names"
      printf '    ssl_certificate     %s;\n' "$CERT"
      printf '    ssl_certificate_key %s;\n' "$KEY"
      printf '    location / {\n        proxy_pass http://$rute_up;\n'
      printf '        proxy_set_header Host $host;\n'
      printf '        proxy_set_header X-Real-IP $remote_addr;\n'
      printf '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n'
      printf '        proxy_set_header X-Forwarded-Proto $scheme;\n'
      printf '        proxy_http_version 1.1;\n'
      printf '        proxy_set_header Upgrade $http_upgrade;\n'
      printf '        proxy_set_header Connection "upgrade";\n'
      printf '    }\n}\n\n'

      printf 'server {\n    listen 443 ssl default_server;\n    server_name _;\n'
      printf '    ssl_certificate     %s;\n' "$CERT"
      printf '    ssl_certificate_key %s;\n' "$KEY"
      printf '    return 404;\n}\n\n'

      printf 'server {\n    listen 80;\n    server_name %s;\n    return 301 https://$host$request_uri;\n}\n\n' "$names"
    fi
  } > "$tmp"
  mv "$tmp" "$CONF"
}

gen_hosts() {
  local tmp; tmp="$(mktemp)"
  [ -f "$HOSTS" ] && awk '/# >>> rute >>>/{s=1} /# <<< rute <<</{s=0; next} !s' "$HOSTS" > "$tmp"
  {
    printf '# >>> rute >>>\n'
    awk 'NF && $1 !~ /^#/ { printf "127.0.0.1 %s\n", $1 }' "$ROUTES"
    printf '# <<< rute <<<\n'
  } >> "$tmp"
  sudo tee "$HOSTS" < "$tmp" >/dev/null
  rm -f "$tmp"
  sudo dscacheutil -flushcache 2>/dev/null
  sudo killall -HUP mDNSResponder 2>/dev/null
}

gen_cert() {
  local ds sig
  ds="$(domains)"
  [ -n "$ds" ] || return 0
  have mkcert || die "mkcert not found — brew install mkcert"
  sig="$(printf '%s\n' "$ds" | shasum | awk '{print $1}')"
  [ "$sig" = "$(cat "$CERT_SIG" 2>/dev/null || true)" ] && [ -f "$CERT" ] && return 0
  mkcert -install >/dev/null 2>&1 || info "mkcert -install failed — run: mkcert -install"
  # shellcheck disable=SC2086
  mkcert -cert-file "$RUTE_HOME/.crt" -key-file "$RUTE_HOME/.key" $ds >/dev/null || die "mkcert failed"
  sudo mkdir -p "$NGINX_CERTS"
  sudo install -m 644 "$RUTE_HOME/.crt" "$CERT"
  sudo install -m 644 "$RUTE_HOME/.key" "$KEY"
  rm -f "$RUTE_HOME/.crt" "$RUTE_HOME/.key"
  printf '%s' "$sig" > "$CERT_SIG"
}

reload_nginx() {
  have nginx || { info "nginx not found — brew install nginx"; return; }
  if pgrep -x nginx >/dev/null 2>&1; then
    sudo nginx -s reload 2>/dev/null || info "nginx reload failed — run: sudo nginx -s reload"
  else
    sudo nginx -t >/dev/null 2>&1 || info "nginx config test failed — run: sudo nginx -t"
    sudo brew services start nginx >/dev/null 2>&1 || info "nginx start failed — run: sudo brew services start nginx"
  fi
}

generate() {
  state_init
  local old; old="$(sum "$CONF")"
  mkdir -p "$NGINX_SERVERS"
  gen_nginx
  gen_cert
  gen_hosts
  [ "$old" != "$(sum "$CONF")" ] && reload_nginx
}

# ---- commands --------------------------------------------------------------

cmd_add() {
  [ $# -eq 2 ] || die "usage: $PROG add <domain> <port>"
  local d; d="$(lower "$1")"
  valid_domain "$d" || die "invalid domain: $1"
  valid_port "$2" || die "invalid port: $2"
  state_add "$d" "$2"
  info "added $d -> 127.0.0.1:$2"
  generate
}

cmd_rm() {
  [ $# -eq 1 ] || die "usage: $PROG rm <domain>"
  local d; d="$(lower "$1")"
  state_del "$d"
  info "removed $d"
  generate
}

cmd_ls() {
  state_init
  [ -s "$ROUTES" ] || { info "no routes yet"; return 0; }
  awk 'NF && $1 !~ /^#/ { printf "%-34s -> 127.0.0.1:%s\n", $1, $2 }' "$ROUTES"
}

cmd_sync() { generate; info "synced"; }

cmd_doctor() {
  local ok=1
  for t in nginx mkcert; do
    if have "$t"; then printf 'ok    %s\n' "$t"; else printf 'MISS  %s (brew install %s)\n' "$t" "$t"; ok=0; fi
  done
  if [ -f "$NGINX_DIR/nginx.conf" ] && grep -Eq 'include[[:space:]]+.*servers/\*' "$NGINX_DIR/nginx.conf"; then
    printf 'ok    nginx.conf includes servers/*\n'
  else
    printf 'WARN  nginx.conf has no "include servers/*.conf;" in http{} — generated conf will not load\n'; ok=0
  fi
  grep -q '# >>> rute >>>' "$HOSTS" 2>/dev/null && printf 'ok    /etc/hosts block present\n' || printf 'WARN  no rute block in %s (run: rute sync)\n' "$HOSTS"
  pgrep -x nginx >/dev/null 2>&1 && printf 'ok    nginx running\n' || printf 'WARN  nginx not running\n'
  if lsof -nP -iTCP:443 -sTCP:LISTEN 2>/dev/null | grep -q nginx; then
    printf 'ok    :443 owned by nginx\n'
  else
    printf 'WARN  :443 not owned by nginx — stop whatever holds it (e.g. mkdev)\n'; ok=0
  fi
  [ "$ok" = 1 ] && printf '\nall good\n'
}

# ---- main ------------------------------------------------------------------

case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  rm|remove) shift; cmd_rm "$@" ;;
  ls|list) shift; cmd_ls "$@" ;;
  sync)   shift; cmd_sync "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  -h|--help|help|"") usage ;;
  -v|--version|version) printf '%s %s\n' "$PROG" "$VERSION" ;;
  *) die "unknown command: $1 (try: $PROG --help)" ;;
esac
