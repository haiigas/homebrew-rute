#!/usr/bin/env bash
# rute — map local domains to ports over HTTPS, and run project dev servers.
# Thin orchestrator over nginx + mkcert + /etc/hosts. No proxy of its own.
set -uo pipefail

VERSION="0.2.9"
PROG="rute"

BREW="${RUTE_PREFIX:-$(brew --prefix 2>/dev/null || echo /opt/homebrew)}"
NGINX_DIR="$BREW/etc/nginx"
NGINX_SERVERS="$NGINX_DIR/servers"
NGINX_CERTS="$NGINX_DIR/certs"
HOSTS="${RUTE_HOSTS:-/etc/hosts}"

RUTE_HOME="${RUTE_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/rute}"
ROUTES="$RUTE_HOME/routes"
PROJECTS="$RUTE_HOME/projects"
CERT_SIG="$RUTE_HOME/certsig"
CONF="$NGINX_SERVERS/rute.conf"
CERT="$NGINX_CERTS/rute.pem"
KEY="$NGINX_CERTS/rute-key.pem"

# ---- helpers ---------------------------------------------------------------

have()  { command -v "$1" >/dev/null 2>&1; }
die()   { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
info()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
sum()   { shasum "$1" 2>/dev/null | awk '{print $1}'; }

usage() {
  cat <<EOF
$PROG $VERSION — map local domains to ports, and run project dev servers

usage:
  $PROG proxy <domain> <port>   reverse-proxy a domain to an already-running port
  $PROG link [dir]              read .rute, start the project's servers, map domains
  $PROG unlink [target]         stop the project and remove its routes
  $PROG up [target]             start a linked project's servers
  $PROG down [target]           stop a linked project's servers
  $PROG restart [target]        stop then start a linked project
  $PROG ls                      list grouped projects and standalone proxies
  $PROG rm <domain>             remove a single route
  $PROG sync                    regenerate nginx/hosts/cert and reload
  $PROG doctor                  check dependencies and services
  $PROG -h | --help
  $PROG --version

.rute (in a project root):
  name  = site
  group = myapp
  [site]
  command = pnpm dev -- --port 4002
  port    = 4002
  domain  = example.dev, api.example.dev

examples:
  $PROG proxy email.example.dev 8025
  cd ~/dev/myapp && $PROG link
  $PROG restart myapp/site
  $PROG down site
EOF
}

valid_domain() {
  printf '%s' "$1" | grep -Eq '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]([a-z0-9-]*[a-z0-9])?$'
}
valid_port() { printf '%s' "$1" | grep -Eq '^[0-9]{1,5}$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

# ---- route state -----------------------------------------------------------

state_init() { mkdir -p "$RUTE_HOME"; [ -f "$ROUTES" ] || : > "$ROUTES"; }

state_add() {
  local d="$1" p="$2" tmp; state_init; tmp="$(mktemp)"
  awk -v d="$d" '!($1==d && $1 !~ /^#/) { print }' "$ROUTES" > "$tmp"
  printf '%s %s\n' "$d" "$p" >> "$tmp"
  mv "$tmp" "$ROUTES"
}
state_del() {
  local d="$1" tmp; state_init; tmp="$(mktemp)"
  awk -v d="$d" '!($1==d && $1 !~ /^#/) { print }' "$ROUTES" > "$tmp"
  mv "$tmp" "$ROUTES"
}
domains() { awk 'NF && $1 !~ /^#/ { print $1 }' "$ROUTES"; }

# ---- generation ------------------------------------------------------------

gen_nginx() {
  local tmp; tmp="$(mktemp)"
  {
    printf '# generated by %s %s — do not edit\n' "$PROG" "$VERSION"
    local names def
    names="$(domains | paste -sd' ' -)"
    def="$(awk 'NF && $1 !~ /^#/ { print $2; exit }' "$ROUTES")"
    [ -n "$def" ] || def=502

    printf 'map $host $rute_up {\n'
    printf '    default 127.0.0.1:%s;\n' "$def"
    awk 'NF && $1 !~ /^#/ { printf "    %s 127.0.0.1:%s;\n", $1, $2 }' "$ROUTES"
    printf '}\n\n'

    if [ -n "$names" ]; then
      printf 'server {\n    listen 443 ssl;\n    listen [::]:443 ssl;\n    http2 on;\n'
      printf '    server_name %s;\n' "$names"
      printf '    ssl_certificate     %s;\n' "$CERT"
      printf '    ssl_certificate_key %s;\n' "$KEY"
      printf '    location / {\n        proxy_pass http://$rute_up;\n'
      printf '        proxy_set_header Host $host;\n'
      printf '        proxy_set_header X-Real-IP $remote_addr;\n'
      printf '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n'
      printf '        proxy_set_header X-Forwarded-Proto $scheme;\n'
      printf '        proxy_http_version 1.1;\n'
      printf '        proxy_set_header Upgrade $http_upgrade;\n'
      printf '        proxy_set_header Connection "upgrade";\n'
      printf '    }\n}\n\n'

      printf 'server {\n    listen 443 ssl default_server;\n    listen [::]:443 ssl default_server;\n    server_name _;\n'
      printf '    ssl_certificate     %s;\n' "$CERT"
      printf '    ssl_certificate_key %s;\n' "$KEY"
      printf '    return 404;\n}\n\n'

      printf 'server {\n    listen 80;\n    listen [::]:80;\n    server_name %s;\n    return 301 https://$host$request_uri;\n}\n\n' "$names"
    fi
  } > "$tmp"
  mv "$tmp" "$CONF"
}

gen_hosts() {
  local tmp; tmp="$(mktemp)"
  [ -f "$HOSTS" ] && awk '/# >>> rute >>>/{s=1} /# <<< rute <<</{s=0; next} !s' "$HOSTS" > "$tmp"
  {
    printf '# >>> rute >>>\n'
    awk 'NF && $1 !~ /^#/ { printf "127.0.0.1 %s\n::1 %s\n", $1, $1 }' "$ROUTES"
    printf '# <<< rute <<<\n'
  } >> "$tmp"

  # Skip sudo if /etc/hosts content is already identical
  if [ -f "$HOSTS" ] && cmp -s "$tmp" "$HOSTS"; then
    rm -f "$tmp"
    return 0
  fi

  sudo cp "$tmp" "$HOSTS" 2>/dev/null || sudo tee "$HOSTS" < "$tmp" >/dev/null
  rm -f "$tmp"
  sudo dscacheutil -flushcache 2>/dev/null
  sudo killall -HUP mDNSResponder 2>/dev/null
}

gen_cert() {
  local ds sig
  ds="$(domains)"
  [ -n "$ds" ] || return 0
  have mkcert || die "mkcert not found — brew install mkcert"
  sig="$(printf '%s\n' "$ds" | shasum | awk '{print $1}')"
  [ "$sig" = "$(cat "$CERT_SIG" 2>/dev/null || true)" ] && [ -f "$CERT" ] && return 0
  mkcert -install >/dev/null 2>&1 || info "mkcert -install failed — run: mkcert -install"
  # shellcheck disable=SC2086
  mkcert -cert-file "$RUTE_HOME/.crt" -key-file "$RUTE_HOME/.key" $ds >/dev/null || die "mkcert failed"
  sudo mkdir -p "$NGINX_CERTS"
  sudo install -m 644 "$RUTE_HOME/.crt" "$CERT"
  sudo install -m 644 "$RUTE_HOME/.key" "$KEY"
  rm -f "$RUTE_HOME/.crt" "$RUTE_HOME/.key"
  printf '%s' "$sig" > "$CERT_SIG"
}

reload_nginx() {
  have nginx || { info "nginx not found — brew install nginx"; return; }
  # try a graceful reload first; fall back to starting the service
  if sudo nginx -s reload >/dev/null 2>&1; then
    return 0
  fi
  sudo brew services start nginx >/dev/null 2>&1 || info "nginx not running / reload failed — run: sudo brew services restart nginx"
}

generate() {
  state_init
  local old; old="$(sum "$CONF")"
  mkdir -p "$NGINX_SERVERS"
  gen_nginx
  gen_cert
  gen_hosts
  if [ "$old" != "$(sum "$CONF")" ]; then reload_nginx; fi
}

# ---- process supervision (project mode) ------------------------------------

wait_port() {
  local port="$1" t="${2:-30}" i=0
  while [ "$i" -lt "$t" ]; do
    nc -z 127.0.0.1 "$port" >/dev/null 2>&1 && return 0
    sleep 0.5; i=$((i + 1))
  done
  return 1
}

pid_on_port() { lsof -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR==2{print $2}'; }

# die if any site's port is already taken — before starting anything
check_ports_free() { # parse-file
  local idx cmd port doms pid
  while IFS=$'\t' read -r idx cmd port doms; do
    [ -n "$port" ] || continue
    if nc -z 127.0.0.1 "$port" >/dev/null 2>&1; then
      pid="$(pid_on_port "$port")"
      die "port $port already in use (pid ${pid:-?}) — stop it first: kill ${pid:-<pid>}"
    fi
  done < "$1"
}

start_site() { # projdir idx dir command port
  local projdir="$1" idx="$2" dir="$3" cmd="$4" port="$5"
  local log="$projdir/site-$idx.log" pidfile="$projdir/site-$idx.pid"
  mkdir -p "$projdir"
  set -m
  ( cd "$dir" && exec bash -lc "$cmd" ) </dev/null >"$log" 2>&1 &
  local pid=$!
  set +m
  printf '%s' "$pid" > "$pidfile"
  if wait_port "$port"; then
    info "site $idx up (pid $pid, port $port)"
    return 0
  fi
  info "site $idx: port $port not ready — see $log"
  return 1
}

stop_site() { # projdir idx
  local pidfile="$1/site-$2.pid"
  [ -f "$pidfile" ] || return 0
  local pid; pid="$(cat "$pidfile" 2>/dev/null)"
  if [ -n "$pid" ]; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    local i=0
    while [ "$i" -lt 15 ]; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
      i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
    fi
  fi
  rm -f "$pidfile"
}

# awk: parse .rute -> "idx<TAB>command<TAB>port<TAB>dom1,dom2,..." per [site]
parse_rute() {
  awk '
    function flush() { if (idx > 0) printf "%d\t%s\t%s\t%s\n", idx, cmd, port, doms }
    /^[[:space:]]*\[site\][[:space:]]*$/ { flush(); idx++; cmd=""; port=""; doms=""; next }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      eq = index($0, "="); if (eq == 0) next
      k = substr($0, 1, eq-1); v = substr($0, eq+1)
      gsub(/^[ \t]+|[ \t]+$/, "", k); gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (k == "command") cmd = v
      else if (k == "port") port = v
      else if (k == "domain") doms = (doms == "" ? v : doms "," v)
    }
    END { flush() }
  ' "$1"
}

rute_group() { # dir
  local g; g="$(awk -F= '/^[[:space:]]*group[[:space:]]*=/{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}' "$1/.rute" 2>/dev/null)"
  [ -n "$g" ] || g="ungrouped"
  printf '%s' "$g"
}

rute_name() { # dir
  local n; n="$(awk -F= '/^[[:space:]]*name[[:space:]]*=/{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2; exit}' "$1/.rute" 2>/dev/null)"
  [ -n "$n" ] || n="$(basename "$1")"
  printf '%s' "$n"
}

_resolve_proj() { # [target] -> prints absolute path to projdir in $PROJECTS
  local target="${1:-}"

  # 1. Target omitted: check $PWD/.rute
  if [ -z "$target" ]; then
    if [ -f "$PWD/.rute" ]; then
      local name group proj_id
      name="$(rute_name "$PWD")"
      group="$(rute_group "$PWD")"
      if [ "$group" != "ungrouped" ] && [ -n "$group" ]; then
        proj_id="${group}__${name}"
      else
        proj_id="$name"
      fi
      if [ -d "$PROJECTS/$proj_id" ]; then
        printf '%s' "$PROJECTS/$proj_id"
        return 0
      elif [ -d "$PROJECTS/$name" ]; then
        printf '%s' "$PROJECTS/$name"
        return 0
      fi
    fi
    die "no project specified and no linked .rute in $PWD"
  fi

  # 2. Target is a directory containing .rute
  if [ -d "$target" ] && [ -f "$target/.rute" ]; then
    local name group proj_id
    name="$(rute_name "$target")"
    group="$(rute_group "$target")"
    if [ "$group" != "ungrouped" ] && [ -n "$group" ]; then
      proj_id="${group}__${name}"
    else
      proj_id="$name"
    fi
    if [ -d "$PROJECTS/$proj_id" ]; then
      printf '%s' "$PROJECTS/$proj_id"
      return 0
    elif [ -d "$PROJECTS/$name" ]; then
      printf '%s' "$PROJECTS/$name"
      return 0
    fi
  fi

  # 3. Direct match: with slash normalized to __
  local norm="${target/\//__}"
  if [ -d "$PROJECTS/$norm" ]; then
    printf '%s' "$PROJECTS/$norm"
    return 0
  fi
  if [ -d "$PROJECTS/$target" ]; then
    printf '%s' "$PROJECTS/$target"
    return 0
  fi

  # 4. Search by project name across all groups
  local matches=()
  for p in "$PROJECTS"/*; do
    [ -d "$p" ] || continue
    local pbase; pbase="$(basename "$p")"
    local pname="$pbase"
    if [ -f "$p/name" ]; then
      pname="$(cat "$p/name" 2>/dev/null)"
    elif [[ "$pbase" == *__* ]]; then
      pname="${pbase#*__}"
    fi

    if [ "$pname" = "$target" ] || [ "$pbase" = "$target" ]; then
      matches+=("$p")
    fi
  done

  if [ ${#matches[@]} -eq 1 ]; then
    printf '%s' "${matches[0]}"
    return 0
  elif [ ${#matches[@]} -gt 1 ]; then
    local list=""
    for m in "${matches[@]}"; do
      local mb; mb="$(basename "$m")"
      local disp="${mb/__//}"
      list="${list} ${disp}"
    done
    die "ambiguous project name '$target' (found:${list}) — use <group>/<name>"
  fi

  die "project not found: $target"
}

# ---- commands --------------------------------------------------------------

cmd_proxy() {
  [ $# -eq 2 ] || die "usage: $PROG proxy <domain> <port>"
  local d; d="$(lower "$1")"
  valid_domain "$d" || die "invalid domain: $1"
  valid_port "$2" || die "invalid port: $2"
  state_add "$d" "$2"
  info "proxied $d -> 127.0.0.1:$2"
  generate
}

cmd_link() {
  local dir="${1:-$PWD}"
  [ -f "$dir/.rute" ] || die "no .rute in $dir"
  local name; name="$(rute_name "$dir")"
  local group; group="$(rute_group "$dir")"

  local proj_id
  if [ "$group" != "ungrouped" ] && [ -n "$group" ]; then
    proj_id="${group}__${name}"
  else
    proj_id="$name"
  fi
  local projdir="$PROJECTS/$proj_id"

  # Clean up old project folder if migrating from ungrouped
  if [ -n "$name" ] && [ -d "$PROJECTS/$name" ] && [ "$PROJECTS/$name" != "$projdir" ]; then
    for f in "$PROJECTS/$name"/site-*.pid; do
      [ -e "$f" ] || continue
      stop_site "$PROJECTS/$name" "$(printf '%s' "$f" | sed 's/.*site-//; s/\.pid//')"
    done
    if [ -f "$PROJECTS/$name/domains" ]; then
      while IFS= read -r d; do [ -n "$d" ] && state_del "$d"; done < "$PROJECTS/$name/domains"
    fi
    rm -rf "$PROJECTS/$name"
  fi

  # Stop old sites of this project
  if [ -d "$projdir" ]; then
    local f
    for f in "$projdir"/site-*.pid; do
      [ -e "$f" ] || continue
      stop_site "$projdir" "$(printf '%s' "$f" | sed 's/.*site-//; s/\.pid//')"
    done
  fi

  local tmp; tmp="$(mktemp)"
  parse_rute "$dir/.rute" > "$tmp"

  # Wait for this project's ports to be released
  while IFS=$'\t' read -r _ _ port _; do
    [ -n "$port" ] || continue
    local i=0
    while [ "$i" -lt 10 ]; do
      nc -z 127.0.0.1 "$port" >/dev/null 2>&1 || break
      sleep 0.2
      i=$((i + 1))
    done
  done < "$tmp"

  check_ports_free "$tmp"

  mkdir -p "$projdir"
  printf '%s' "$dir" > "$projdir/dir"
  printf '%s' "$name" > "$projdir/name"
  printf '%s' "$group" > "$projdir/group"

  local old_domains=""
  if [ -f "$projdir/domains" ]; then
    old_domains="$(cat "$projdir/domains")"
  fi

  local new_domains=""
  local idx cmd port doms
  while IFS=$'\t' read -r idx cmd port doms; do
    [ -n "$cmd" ]  || die "site $idx: missing command"
    [ -n "$port" ] || die "site $idx: missing port"
    start_site "$projdir" "$idx" "$dir" "$cmd" "$port"
    local d
    for d in $(printf '%s' "$doms" | tr ',' ' '); do
      d="$(lower "$d")"
      valid_domain "$d" || { info "skip invalid domain: $d"; continue; }
      state_add "$d" "$port"
      new_domains="${new_domains}${d}"$'\n'
      info "  linked https://$d -> 127.0.0.1:$port"
    done
  done < "$tmp"
  rm -f "$tmp"

  if [ -n "$old_domains" ]; then
    while IFS= read -r old_d; do
      [ -z "$old_d" ] && continue
      if ! printf '%s' "$new_domains" | grep -qx "$old_d"; then
        state_del "$old_d"
      fi
    done <<< "$old_domains"
  fi

  printf '%s' "$new_domains" > "$projdir/domains"
  generate
}

cmd_unlink() {
  local projdir; projdir="$(_resolve_proj "${1:-}")"
  local disp; disp="$(basename "$projdir")"
  disp="${disp/__//}"

  local f
  for f in "$projdir"/site-*.pid; do
    [ -e "$f" ] || continue
    stop_site "$projdir" "$(printf '%s' "$f" | sed 's/.*site-//; s/\.pid//')"
  done
  if [ -f "$projdir/domains" ]; then
    while IFS= read -r d; do [ -n "$d" ] && state_del "$d"; done < "$projdir/domains"
  fi
  rm -rf "$projdir"
  info "unlinked $disp"
  generate
}

cmd_up() {
  local target="${1:-}"
  if [ "$target" = "--all" ] || [ "$target" = "-a" ]; then
    if [ -d "$PROJECTS" ]; then
      for p in "$PROJECTS"/*; do
        [ -d "$p" ] || continue
        local dir; dir="$(cat "$p/dir" 2>/dev/null)"
        [ -f "$dir/.rute" ] || continue
        local running=0 f pid
        for f in "$p"/site-*.pid; do
          [ -e "$f" ] || continue
          pid="$(cat "$f" 2>/dev/null)"
          if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            running=1; break
          fi
        done
        if [ "$running" = 0 ]; then
          cmd_link "$dir"
        fi
      done
    fi
    return 0
  fi

  local projdir; projdir="$(_resolve_proj "${1:-}")"
  local dir; dir="$(cat "$projdir/dir" 2>/dev/null)"
  [ -f "$dir/.rute" ] || die "no .rute in $dir"

  local running=0 f pid
  for f in "$projdir"/site-*.pid; do
    [ -e "$f" ] || continue
    pid="$(cat "$f" 2>/dev/null)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      running=1; break
    fi
  done
  if [ "$running" = 1 ]; then
    local disp; disp="$(basename "$projdir")"
    disp="${disp/__//}"
    info "$disp is already running (use 'rute restart' to restart)"
    return 0
  fi

  cmd_link "$dir"
}

cmd_down() {
  local target="${1:-}"
  if [ "$target" = "--all" ] || [ "$target" = "-a" ]; then
    if [ -d "$PROJECTS" ]; then
      for p in "$PROJECTS"/*; do
        [ -d "$p" ] || continue
        for f in "$p"/site-*.pid; do
          [ -e "$f" ] || continue
          stop_site "$p" "$(printf '%s' "$f" | sed 's/.*site-//; s/\.pid//')"
        done
        local disp; disp="$(basename "$p")"
        disp="${disp/__//}"
        info "stopped $disp"
      done
    fi
    return 0
  fi

  local projdir; projdir="$(_resolve_proj "${1:-}")"
  local disp; disp="$(basename "$projdir")"
  disp="${disp/__//}"

  local f
  for f in "$projdir"/site-*.pid; do
    [ -e "$f" ] || continue
    stop_site "$projdir" "$(printf '%s' "$f" | sed 's/.*site-//; s/\.pid//')"
  done
  info "stopped $disp"
}

cmd_restart() {
  local target="${1:-}"
  if [ "$target" = "--all" ] || [ "$target" = "-a" ]; then
    cmd_down --all
    cmd_up --all
    return 0
  fi

  local projdir; projdir="$(_resolve_proj "${1:-}")"
  local dir; dir="$(cat "$projdir/dir" 2>/dev/null)"
  [ -f "$dir/.rute" ] || die "no .rute in $dir"
  cmd_link "$dir"
}

cmd_rm() {
  [ $# -eq 1 ] || die "usage: $PROG rm <domain>"
  local d; d="$(lower "$1")"
  state_del "$d"
  info "removed $d"
  generate
}

cmd_ls() {
  state_init

  local proj_domains_file; proj_domains_file="$(mktemp)"
  if [ -d "$PROJECTS" ]; then
    for p in "$PROJECTS"/*; do
      [ -d "$p" ] || continue
      if [ -f "$p/domains" ]; then
        cat "$p/domains" >> "$proj_domains_file"
      fi
    done
  fi

  printf 'PROJECTS:\n'
  local has_projects=0

  if [ -d "$PROJECTS" ] && [ -n "$(ls -A "$PROJECTS" 2>/dev/null)" ]; then
    local proj_data_file; proj_data_file="$(mktemp)"

    for p in "$PROJECTS"/*; do
      [ -d "$p" ] || continue
      local pbase; pbase="$(basename "$p")"
      local pdir=""; [ -f "$p/dir" ] && pdir="$(cat "$p/dir" 2>/dev/null)"

      local group=""
      local name=""

      if [ -f "$p/group" ]; then
        group="$(cat "$p/group" 2>/dev/null)"
      fi
      if [ -f "$p/name" ]; then
        name="$(cat "$p/name" 2>/dev/null)"
      fi

      if [ -z "$group" ] && [ -f "$pdir/.rute" ]; then
        group="$(rute_group "$pdir")"
      fi
      if [ -z "$name" ] && [ -f "$pdir/.rute" ]; then
        name="$(rute_name "$pdir")"
      fi

      if [ -z "$group" ]; then
        if [[ "$pbase" == *__* ]]; then
          group="${pbase%%__*}"
        else
          group="ungrouped"
        fi
      fi

      if [ -z "$name" ]; then
        if [[ "$pbase" == *__* ]]; then
          name="${pbase#*__}"
        else
          name="$pbase"
        fi
      fi

      local is_up=0
      for f in "$p"/site-*.pid; do
        [ -e "$f" ] || continue
        local pid; pid="$(cat "$f" 2>/dev/null)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
          is_up=1
          break
        fi
      done

      local dot="○"
      local st="[down]"
      if [ "$is_up" -eq 1 ]; then
        dot="●"
        st="[up]"
      fi

      local p_ports=""
      local p_doms=""
      if [ -f "$pdir/.rute" ]; then
        while IFS=$'\t' read -r _ _ s_port s_doms; do
          [ -n "$s_port" ] || continue
          p_ports="${p_ports:+${p_ports}, }:${s_port}"
          for d in $(printf '%s' "$s_doms" | tr ',' ' '); do
            p_doms="${p_doms:+${p_doms}, }${d}"
          done
        done < <(parse_rute "$pdir/.rute")
      fi

      if [ -z "$p_ports" ] && [ -f "$p/domains" ]; then
        while IFS= read -r d; do
          [ -z "$d" ] && continue
          p_doms="${p_doms:+${p_doms}, }${d}"
          local dport; dport="$(awk -v d="$d" '$1==d {print $2; exit}' "$ROUTES")"
          if [ -n "$dport" ]; then
            p_ports="${p_ports:+${p_ports}, }:${dport}"
          fi
        done < "$p/domains"
      fi

      [ -n "$p_ports" ] || p_ports="-"
      [ -n "$p_doms" ] || p_doms="-"

      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$group" "$name" "$dot" "$st" "$p_ports" "$p_doms" >> "$proj_data_file"
      has_projects=1
    done

    if [ "$has_projects" -eq 1 ]; then
      local groups
      groups=$(awk -F'\t' '{print $1}' "$proj_data_file" | sort -u)

      local reordered_groups=""
      for g in $groups; do
        if [ "$g" != "ungrouped" ]; then
          reordered_groups="${reordered_groups}${g}"$'\n'
        fi
      done
      if echo "$groups" | grep -qx "ungrouped"; then
        reordered_groups="${reordered_groups}ungrouped"$'\n'
      fi

      local first_group=1
      while IFS= read -r grp; do
        [ -z "$grp" ] && continue
        if [ "$first_group" -eq 0 ]; then
          printf '\n'
        fi
        first_group=0

        printf '  [%s]\n' "$grp"
        awk -F'\t' -v g="$grp" '
          $1 == g {
            n = split($6, d, ", ")
            printf "    %s %-10s  %-6s  %-7s  %s\n", $3, $2, $4, $5, d[1]
            for (i = 2; i <= n; i++) {
              if (d[i] != "") {
                printf "                                   %s\n", d[i]
              }
            }
          }
        ' "$proj_data_file"
      done <<< "$reordered_groups"
    else
      printf '  (none)\n'
    fi
    rm -f "$proj_data_file"
  else
    printf '  (none)\n'
  fi

  printf '\nPROXIES:\n'
  local has_proxies=0
  if [ -s "$ROUTES" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      local d p
      d="$(echo "$line" | awk '{print $1}')"
      p="$(echo "$line" | awk '{print $2}')"
      [ -n "$d" ] && [ -n "$p" ] || continue

      if ! grep -qx "$d" "$proj_domains_file" 2>/dev/null; then
        printf '  ● %-30s -> :%s\n' "$d" "$p"
        has_proxies=1
      fi
    done < "$ROUTES"
  fi

  if [ "$has_proxies" -eq 0 ]; then
    printf '  (none)\n'
  fi

  rm -f "$proj_domains_file"
}

cmd_sync() { generate; info "synced"; }

cmd_doctor() {
  local ok=1
  for t in nginx mkcert; do
    if have "$t"; then printf 'ok    %s\n' "$t"; else printf 'MISS  %s (brew install %s)\n' "$t" "$t"; ok=0; fi
  done
  if [ -f "$NGINX_DIR/nginx.conf" ] && grep -Eq 'include[[:space:]]+.*servers/\*' "$NGINX_DIR/nginx.conf"; then
    printf 'ok    nginx.conf includes servers/*\n'
  else
    printf 'WARN  nginx.conf has no "include servers/*.conf;" in http{}\n'; ok=0
  fi
  grep -q '# >>> rute >>>' "$HOSTS" 2>/dev/null && printf 'ok    /etc/hosts block present\n' || printf 'WARN  no rute block in %s (run: rute sync)\n' "$HOSTS"
  if lsof -nP -iTCP:80 -sTCP:LISTEN 2>/dev/null | grep -q nginx || lsof -nP -iTCP:443 -sTCP:LISTEN 2>/dev/null | grep -q nginx; then
    printf 'ok    nginx running\n'
  else
    printf 'WARN  nginx not running\n'
  fi
  if lsof -nP -iTCP:443 -sTCP:LISTEN 2>/dev/null | grep -q nginx; then
    printf 'ok    :443 owned by nginx\n'
  else
    printf 'WARN  :443 not owned by nginx — stop whatever holds it\n'; ok=0
  fi
  [ "$ok" = 1 ] && printf '\nall good\n'
}

# ---- main ------------------------------------------------------------------

case "${1:-}" in
  proxy|add) shift; cmd_proxy "$@" ;;
  link)   shift; cmd_link "$@" ;;
  unlink) shift; cmd_unlink "$@" ;;
  up)     shift; cmd_up "$@" ;;
  down)   shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  rm|remove) shift; cmd_rm "$@" ;;
  ls|list) shift; cmd_ls "$@" ;;
  sync)   shift; cmd_sync "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  -h|--help|help|"") usage ;;
  -v|--version|version) printf '%s %s\n' "$PROG" "$VERSION" ;;
  *) die "unknown command: $1 (try: $PROG --help)" ;;
esac
